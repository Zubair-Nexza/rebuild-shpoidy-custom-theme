{%- comment -%}
  sections/main-404.liquid
  Clean Sport 404: centred display headline over faint pitch markings,
  subtitle and a Volt / outline CTA pair.
{%- endcomment -%}

{%- style -%}
  @keyframes n90-nf-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  @keyframes n90-nf-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

  .n90-nf {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: min(78vh, 760px);
    padding: 64px clamp(16px, 3vw, 40px);
    overflow: hidden;
    background: var(--n90-canvas);
    color: var(--n90-carbon);
    font-family: var(--n90-font-body);
    text-align: center;
  }
  .n90-nf__pitch {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(1100px, 140vw);
    height: auto;
    transform: translate(-50%, -50%);
    color: rgba(0, 0, 0, .06);
    pointer-events: none;
  }
  .n90-nf__pitch * { stroke-dasharray: 1; stroke-dashoffset: 0; animation: n90-nf-draw 1.6s var(--n90-ease) both; }
  .n90-nf__inner { position: relative; max-width: 880px; }
  .n90-nf__eyebrow,
  .n90-nf__title,
  .n90-nf__sub,
  .n90-nf__ctas { animation: n90-nf-up .7s var(--n90-ease) both; }
  .n90-nf__title { animation-delay: .08s; }
  .n90-nf__sub { animation-delay: .16s; }
  .n90-nf__ctas { animation-delay: .24s; }
  .n90-nf__eyebrow { margin: 0 0 18px; font-family: var(--n90-font-display); font-weight: 600; font-size: 14px; letter-spacing: .18em; text-transform: uppercase; color: var(--n90-muted); }
  .n90-nf__title {
    margin: 0;
    font-family: var(--n90-font-display);
    font-weight: 700;
    font-size: clamp(56px, 10vw, 152px);
    line-height: .88;
    letter-spacing: .005em;
    text-transform: uppercase;
  }
  .n90-nf__code { display: inline-block; padding: 0 .12em; border-radius: 12px; background: var(--n90-volt); }
  .n90-nf__slash { color: var(--n90-muted); font-weight: 600; }
  .n90-nf__sub { margin: 28px auto 0; max-width: 560px; font-size: 18px; line-height: 1.6; color: var(--n90-muted); }
  .n90-nf__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 40px; }
  .n90-nf__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 56px;
    padding: 0 28px;
    border: 2px solid var(--n90-carbon);
    border-radius: 12px;
    background: transparent;
    color: var(--n90-carbon);
    font-family: var(--n90-font-display);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: .07em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background .25s, color .25s, border-color .25s, transform .35s var(--n90-spring);
  }
  .n90-nf__btn svg { width: 16px; height: 16px; transition: transform .35s var(--n90-spring); }
  .n90-nf__btn:hover { transform: translateY(-2px); background: var(--n90-carbon); color: var(--n90-canvas); }
  .n90-nf__btn:active { transform: scale(.98); }
  .n90-nf__btn--volt { border-color: var(--n90-volt); background: var(--n90-volt); }
  .n90-nf__btn--volt:hover { border-color: var(--n90-carbon); background: var(--n90-volt); color: var(--n90-carbon); }
  .n90-nf__btn--volt:hover svg { transform: translateX(4px); }
  .n90-nf__btn:focus-visible { outline: 2px solid var(--n90-carbon); outline-offset: 3px; }

  @media (max-width: 599px) {
    .n90-nf__sub { font-size: 16px; }
    .n90-nf__ctas { flex-direction: column; }
    .n90-nf__btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .n90-nf__pitch *,
    .n90-nf__eyebrow,
    .n90-nf__title,
    .n90-nf__sub,
    .n90-nf__ctas { animation: none; }
    .n90-nf__btn,
    .n90-nf__btn svg { transition: none; }
  }
{%- endstyle -%}

{%- liquid
  assign primary_url = section.settings.primary_url | default: routes.root_url
  assign secondary_url = section.settings.secondary_url | default: routes.all_products_collection_url
-%}

<div class="n90-nf">
  <svg class="n90-nf__pitch" viewBox="0 0 1100 700" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true" focusable="false">
    <rect x="20" y="20" width="1060" height="660" rx="12" pathLength="1"/>
    <path d="M550 20v660" pathLength="1"/>
    <circle cx="550" cy="350" r="110" pathLength="1"/>
    <path d="M20 190h150v320H20M1080 190H930v320h150" pathLength="1"/>
  </svg>

  <div class="n90-nf__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="n90-nf__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="n90-nf__title">
      <span class="n90-nf__code">404</span> <span class="n90-nf__slash" aria-hidden="true">//</span>
      {{ section.settings.heading | escape }}
    </h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="n90-nf__sub">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    <div class="n90-nf__ctas">
      <a class="n90-nf__btn n90-nf__btn--volt" href="{{ primary_url }}">
        {{- section.settings.primary_label | escape -}}
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 8h12M9 3l5 5-5 5"/></svg>
      </a>
      <a class="n90-nf__btn" href="{{ secondary_url }}">{{ section.settings.secondary_label | escape }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Error 404" },
    { "type": "text", "id": "heading", "label": "Heading (after “404 //”)", "default": "Off the pitch" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "The page or kit you're looking for doesn't exist, has moved, or is currently out of rotation." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Return to home" },
    { "type": "url", "id": "primary_url", "label": "Primary button link", "info": "Defaults to the homepage." },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Explore all gear" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link", "info": "Defaults to all products." }
  ]
}
{% endschema %}
