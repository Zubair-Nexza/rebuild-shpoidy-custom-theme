{%- comment -%}
  sections/pre-season-banner.liquid
  ROSTER — Pre-season custom kit CTA banner ("Order by [date] for pre-season")
  Reference: data-section="PromoBanner" (.promo-sec.promo-late / .promo / .promo-text / .promo-media + .promo-art)

  Surface card split 6 / 6: copy + Volt CTA on the left; pitch lines with a floating
  track jacket and football (reference KitArt) or an uploaded image on the right,
  plus a camera caption. Motion from the reference: visual zooms 1.03 over 1.2s on
  hover, art floats (mFloat 7s / 5.5s), button shine + arrow nudge, scroll reveal.
  Brand changes: 16px corners and a hairline border.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --psb-pt: {{ section.settings.padding_top }}px;
    --psb-pb: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<style>
  @keyframes n90-psb-float {
    0%, 100% { transform: translateY(0) rotate(var(--r, 0deg)); }
    50% { transform: translateY(-14px) rotate(calc(var(--r, 0deg) + 1.5deg)); }
  }
  @keyframes n90-psb-shine {
    from { transform: translateX(-140%) skewX(-20deg); }
    to   { transform: translateX(260%) skewX(-20deg); }
  }

  /* ref .promo-sec.promo-late */
  .n90-psb {
    padding: var(--psb-pt) 0 var(--psb-pb);
    background: var(--n90-canvas);
    color: var(--n90-carbon);
    font-family: var(--n90-font-body);
  }

  /* ref .promo */
  .n90-psb__card {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: stretch;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(0, 0, 0, .06);
    background: var(--n90-surface);
  }

  /* ref .promo-text */
  .n90-psb__text {
    grid-column: 1 / span 6;
    padding: 64px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: center;
  }
  .n90-psb__eyebrow {
    margin: 0;
    font-family: var(--n90-font-display);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .n90-psb__heading {
    margin: 0;
    font-family: var(--n90-font-display);
    font-weight: 700;
    font-size: clamp(40px, 4.2vw, 60px);
    line-height: .95;
    letter-spacing: .005em;
    text-transform: uppercase;
  }
  /* ref .lead */
  .n90-psb__lead {
    margin: 0;
    max-width: 520px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--n90-muted);
  }
  .n90-psb__lead strong { color: var(--n90-carbon); font-weight: 600; }

  /* ref .cta */
  .n90-psb__cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 8px;
  }
  /* ref .btn — Volt, lift + shine + arrow nudge */
  .n90-psb__btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 28px;
    background: var(--n90-volt);
    color: var(--n90-carbon);
    font-family: var(--n90-font-display);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: .07em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--n90-radius);
    transition: transform .35s var(--n90-ease), box-shadow .35s var(--n90-ease);
  }
  .n90-psb__btn::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    background: rgba(255, 255, 255, .5);
    transform: translateX(-140%) skewX(-20deg);
    pointer-events: none;
  }
  .n90-psb__btn:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -12px rgba(var(--n90-carbon-rgb), .45); }
  .n90-psb__btn:hover::after { animation: n90-psb-shine .9s var(--n90-ease); }
  .n90-psb__btn:active { transform: scale(.97); box-shadow: none; }
  .n90-psb__btn svg { width: 16px; height: 16px; transition: transform .35s var(--n90-ease); }
  .n90-psb__btn:hover svg { transform: translateX(4px); }
  /* ref .tlink */
  .n90-psb__tlink {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--n90-carbon);
    font-family: var(--n90-font-display);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: .07em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 7px;
    text-decoration-thickness: 1px;
    transition: text-underline-offset .25s var(--n90-ease), text-decoration-thickness .15s;
  }
  .n90-psb__tlink:hover { text-underline-offset: 4px; text-decoration-thickness: 2px; }

  /* ref .promo-media — zooms 1.03 when the card is hovered */
  .n90-psb__media {
    grid-column: 7 / span 6;
    position: relative;
    min-height: 380px;
    overflow: hidden;
    color: var(--n90-carbon);
    transition: transform 1.2s var(--n90-ease);
  }
  .n90-psb__card:hover .n90-psb__media { transform: scale(1.03); }
  .n90-psb__media > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .n90-psb__pitch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: .07;
    pointer-events: none;
  }
  /* ref .promo-art — jacket + ball floating */
  .n90-psb__art {
    position: absolute;
    inset: 10% 8%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4%;
  }
  .n90-psb__art-a { flex: 0 0 42%; }
  .n90-psb__art-b { flex: 0 0 30%; margin-top: 22%; }
  .n90-psb__art .n90-kit-art { display: block; width: 100%; height: auto; }
  .n90-psb__art-a .n90-kit-art { --r: -4deg; animation: n90-psb-float 7s ease-in-out infinite; }
  .n90-psb__art-b .n90-kit-art { --r: 6deg; animation: n90-psb-float 5.5s -2s ease-in-out infinite; }

  /* ref .slot-label */
  .n90-psb__caption {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 14px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 12px;
    line-height: 1.35;
    letter-spacing: .02em;
    color: var(--n90-muted);
  }
  .n90-psb__media--photo .n90-psb__caption { color: var(--n90-canvas); text-shadow: 0 1px 2px rgba(0, 0, 0, .4); }
  .n90-psb__caption svg { width: 16px; height: 16px; flex: none; opacity: .8; }

  .n90-psb :focus-visible { outline: 2px solid var(--n90-carbon); outline-offset: 3px; }

  /* Laptop 1024–1279: less inner padding */
  @media screen and (max-width: 1279px) {
    .n90-psb__text { padding: 48px; }
  }
  /* Tablet + mobile < 1024: copy on top, visual below */
  @media screen and (max-width: 1023px) {
    .n90-psb__card { display: flex; flex-direction: column; }
    .n90-psb__text { padding: 40px; }
    .n90-psb__media { min-height: 320px; }
  }
  /* Mobile — ref .is-m .promo */
  @media screen and (max-width: 767px) {
    .n90-psb { padding: min(var(--psb-pt), 64px) 0 min(var(--psb-pb), 64px); }
    .n90-psb__text { padding: 28px 20px; gap: 16px; }
    .n90-psb__lead { font-size: 16px; }
    .n90-psb__cta { flex-direction: column; align-items: stretch; gap: 4px; }
    .n90-psb__btn { width: 100%; }
    .n90-psb__tlink { justify-content: center; }
    .n90-psb__media { min-height: 240px; }
    .n90-psb__caption { left: 12px; right: 12px; bottom: 10px; font-size: 11px; }
  }

  @media (hover: none) {
    .n90-psb__card:hover .n90-psb__media,
    .n90-psb__btn:hover { transform: none; box-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .n90-psb__art .n90-kit-art,
    .n90-psb__btn:hover::after { animation: none; }
    .n90-psb__media,
    .n90-psb__btn,
    .n90-psb__btn svg { transition: none; }
  }
</style>

<section class="n90-psb" aria-labelledby="n90-psb-title-{{ section.id }}">
  <div class="page-width">
    <div class="n90-psb__card" data-n90-reveal>
      <div class="n90-psb__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="n90-psb__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="n90-psb__heading" id="n90-psb-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="n90-psb__lead">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
          <div class="n90-psb__cta">
            {%- if section.settings.button_label != blank -%}
              <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="n90-psb__btn">
                {{- section.settings.button_label | escape -}}
                {%- render 'icon', name: 'arrow' -%}
              </a>
            {%- endif -%}
            {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
              <a href="{{ section.settings.link_url }}" class="n90-psb__tlink">{{ section.settings.link_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="n90-psb__media{% if section.settings.image != blank %} n90-psb__media--photo{% endif %}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 800, 1000, 1400',
              sizes: '(min-width: 1024px) 50vw, 100vw',
              loading: 'lazy', decoding: 'async',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          <svg class="n90-psb__pitch" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <rect x="40" y="40" width="720" height="520"/><line x1="400" y1="40" x2="400" y2="560"/><circle cx="400" cy="300" r="80"/><circle cx="400" cy="300" r="4" fill="currentColor"/><rect x="40" y="160" width="120" height="280"/><rect x="640" y="160" width="120" height="280"/><rect x="40" y="240" width="44" height="120"/><rect x="716" y="240" width="44" height="120"/><path d="M160 250a60 60 0 0 1 0 100M640 250a60 60 0 0 0 0 100"/>
          </svg>
          <div class="n90-psb__art" aria-hidden="true">
            <div class="n90-psb__art-a">{%- render 'n90-kit-art', kind: 'jacket' -%}</div>
            <div class="n90-psb__art-b">{%- render 'n90-kit-art', kind: 'ball' -%}</div>
          </div>
        {%- endif -%}

        {%- if section.settings.caption != blank -%}
          <p class="n90-psb__caption">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="3" y="7" width="18" height="13" rx="1"/><circle cx="12" cy="13.5" r="3.5"/><path d="M8 7l1.5-3h5L16 7"/></svg>
            <span>{{ section.settings.caption | escape }}</span>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pre-season banner",
  "tag": "div",
  "class": "section-pre-season-banner",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pre-season" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order by [date] for pre-season" },
    {
      "type": "inline_richtext", "id": "description", "label": "Description",
      "default": "3–4 week turnaround, free design and quote. First order? Take 10% off with <strong>ROSTER10<\/strong>."
    },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start your kit" },
    {
      "type": "url", "id": "button_url", "label": "Button link",
      "info": "Defaults to all products until your quote page exists."
    },
    { "type": "header", "content": "Text link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Or set up a club shop" },
    {
      "type": "url", "id": "link_url", "label": "Link",
      "info": "The link is hidden until a destination is set."
    },
    { "type": "header", "content": "Visual" },
    {
      "type": "image_picker", "id": "image", "label": "Image",
      "info": "Without an image, the reference mock (pitch lines + floating track jacket and football) is shown."
    },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Photo: squad warming up in training kit" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range", "id": "padding_top", "label": "Padding top",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112
    },
    {
      "type": "range", "id": "padding_bottom", "label": "Padding bottom",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112
    }
  ],
  "presets": [
    { "name": "Pre-season banner" }
  ]
}
{% endschema %}
