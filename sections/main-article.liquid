{%- comment -%}
  sections/main-article.liquid
  ROSTER — Editorial article reader

  Centred 820px column: back link, tag badge, big condensed title, author / date /
  read-time row, 16:9 featured image (LCP), long-form typography (1.75 line height,
  Volt blockquote bar), share row (X, Facebook, LinkedIn, WhatsApp, copy link),
  previous / next + back to journal, and comments when the blog allows them.
{%- endcomment -%}

{%- liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_mins = word_count | divided_by: 200 | at_least: 1
  assign share_url = request.origin | append: article.url
  assign share_url_enc = share_url | url_encode
  assign share_title_enc = article.title | url_encode
-%}

<style>
  @keyframes n90-ar-up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

  .n90-ar {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--n90-canvas);
    color: var(--n90-carbon);
    font-family: var(--n90-font-body);
  }
  .n90-ar__col { max-width: 820px; margin: 0 auto; }
  .n90-ar__wide { max-width: 1120px; margin: 0 auto; }

  .n90-ar__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--n90-muted);
    font-family: var(--n90-font-display);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .n90-ar__back:hover { color: var(--n90-carbon); }
  .n90-ar__back svg { width: 14px; height: 14px; transform: rotate(180deg); }

  .n90-ar__head { padding: 16px 0 32px; animation: n90-ar-up .6s var(--n90-ease) both; }
  .n90-ar__tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 18px; padding: 0; list-style: none; }
  .n90-ar__tags a {
    display: inline-block;
    padding: 5px 10px 4px;
    border-radius: var(--n90-radius);
    background: var(--n90-volt);
    color: var(--n90-carbon);
    font-family: var(--n90-font-display);
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .n90-ar__title {
    margin: 0;
    font-family: var(--n90-font-display);
    font-weight: 700;
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: .95;
    letter-spacing: .005em;
    text-transform: uppercase;
  }
  .n90-ar__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
    margin: 24px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid rgba(0, 0, 0, .08);
    font-size: 14px;
    color: var(--n90-muted);
  }
  .n90-ar__meta strong { color: var(--n90-carbon); font-weight: 600; }

  .n90-ar__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin: 8px 0 56px;
    border-radius: 12px;
    background: var(--n90-surface);
  }
  .n90-ar__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Long-form typography */
  .n90-ar__body { font-size: 18px; line-height: 1.75; }
  .n90-ar__body > :first-child { margin-top: 0; }
  .n90-ar__body p { margin: 0 0 1.4em; }
  .n90-ar__body h2,
  .n90-ar__body h3,
  .n90-ar__body h4 { font-family: var(--n90-font-display); font-weight: 700; line-height: 1.05; text-transform: uppercase; letter-spacing: .005em; }
  .n90-ar__body h2 { margin: 2em 0 .6em; font-size: clamp(30px, 3vw, 40px); }
  .n90-ar__body h3 { margin: 1.8em 0 .5em; font-size: clamp(24px, 2.2vw, 30px); }
  .n90-ar__body h4 { margin: 1.6em 0 .4em; font-size: 20px; }
  .n90-ar__body a { color: var(--n90-carbon); text-decoration: underline; text-decoration-color: var(--n90-volt); text-decoration-thickness: 3px; text-underline-offset: 3px; }
  .n90-ar__body a:hover { text-decoration-color: var(--n90-carbon); }
  .n90-ar__body ul,
  .n90-ar__body ol { margin: 0 0 1.4em; padding-left: 1.3em; }
  .n90-ar__body li { margin-bottom: .4em; }
  .n90-ar__body li::marker { color: var(--n90-carbon); font-weight: 700; }
  .n90-ar__body blockquote {
    margin: 2em 0;
    padding: 8px 0 8px 28px;
    border-left: 6px solid var(--n90-volt);
    font-family: var(--n90-font-display);
    font-weight: 600;
    font-size: clamp(24px, 2.4vw, 32px);
    line-height: 1.2;
    text-transform: uppercase;
  }
  .n90-ar__body blockquote p:last-child { margin-bottom: 0; }
  .n90-ar__body img { max-width: 100%; height: auto; border-radius: 12px; }
  .n90-ar__body figure { margin: 2em 0; }
  .n90-ar__body figcaption { margin-top: 8px; font-size: 13px; color: var(--n90-muted); }
  .n90-ar__body hr { margin: 3em 0; border: 0; border-top: 1px solid rgba(0, 0, 0, .08); }
  .n90-ar__body table { width: 100%; border-collapse: collapse; font-size: 16px; }
  .n90-ar__body th,
  .n90-ar__body td { padding: 10px 12px; border-bottom: 1px solid rgba(0, 0, 0, .08); text-align: left; }
  .n90-ar__body iframe { max-width: 100%; border-radius: 12px; }

  /* Share */
  .n90-ar__share { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 48px; padding-top: 24px; border-top: 1px solid rgba(0, 0, 0, .08); }
  .n90-ar__share-k { margin: 0 8px 0 0; font-family: var(--n90-font-display); font-weight: 600; font-size: 14px; letter-spacing: .18em; text-transform: uppercase; }
  .n90-ar__sh {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 0, 0, .12);
    border-radius: 50%;
    background: var(--n90-canvas);
    color: var(--n90-carbon);
    cursor: pointer;
    transition: background .2s, border-color .2s, transform .35s var(--n90-spring);
  }
  .n90-ar__sh:hover { background: var(--n90-volt); border-color: var(--n90-volt); transform: translateY(-2px); }
  .n90-ar__sh svg { width: 18px; height: 18px; }
  .n90-ar__copied { font-size: 13px; color: var(--n90-muted); }

  /* Prev / next */
  .n90-ar__nav { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 64px; }
  .n90-ar__nav a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    border: 1px solid rgba(0, 0, 0, .08);
    border-radius: 12px;
    background: var(--n90-surface);
    color: var(--n90-carbon);
    text-decoration: none;
    transition: transform .45s var(--n90-spring), border-color .25s;
  }
  .n90-ar__nav a:hover { transform: translateY(-3px); border-color: var(--n90-carbon); }
  .n90-ar__nav .is-next { text-align: right; grid-column: 2; }
  .n90-ar__nav-k { font-size: 13px; color: var(--n90-muted); }
  .n90-ar__nav-v { font-family: var(--n90-font-display); font-weight: 700; font-size: 22px; text-transform: uppercase; }
  .n90-ar__journal { display: flex; justify-content: center; margin-top: 24px; }
  .n90-ar__journal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--n90-carbon);
    font-family: var(--n90-font-display);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: .07em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 7px;
  }

  /* Comments */
  .n90-ar__comments { margin-top: 80px; padding-top: 40px; border-top: 1px solid rgba(0, 0, 0, .08); }
  .n90-ar__h2 { margin: 0 0 24px; font-family: var(--n90-font-display); font-weight: 700; font-size: 28px; text-transform: uppercase; }
  .n90-ar__comment { padding: 20px 0; border-bottom: 1px solid rgba(0, 0, 0, .08); font-size: 16px; line-height: 1.7; }
  .n90-ar__comment footer { margin-top: 8px; font-size: 13px; color: var(--n90-muted); }
  .n90-ar__cform { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 32px; }
  .n90-ar__field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .n90-ar__field--full { grid-column: 1 / -1; }
  .n90-ar__field label { font-family: var(--n90-font-display); font-weight: 600; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; }
  .n90-ar__input {
    min-height: 52px;
    padding: 0 16px;
    border: 1px solid rgba(0, 0, 0, .08);
    border-radius: 12px;
    background: var(--n90-surface);
    color: var(--n90-carbon);
    font: inherit;
    font-size: 16px;
  }
  textarea.n90-ar__input { min-height: 140px; padding: 14px 16px; resize: vertical; line-height: 1.6; }
  .n90-ar__input:focus { outline: none; border-color: var(--n90-carbon); background: var(--n90-canvas); box-shadow: 0 0 0 4px rgba(var(--n90-volt-rgb), .7); }
  .n90-ar__submit {
    grid-column: 1 / -1;
    justify-self: start;
    min-height: 52px;
    padding: 0 28px;
    border: 0;
    border-radius: 12px;
    background: var(--n90-volt);
    color: var(--n90-carbon);
    font-family: var(--n90-font-display);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: .07em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform .35s var(--n90-ease);
  }
  .n90-ar__submit:hover { transform: translateY(-2px); }
  .n90-ar__msg { grid-column: 1 / -1; margin: 0; padding: 14px 16px; border-radius: 12px; font-size: 15px; }
  .n90-ar__msg--ok { background: var(--n90-volt); }
  .n90-ar__msg--err { background: #FDECEA; color: #B42318; }
  .n90-ar__note { grid-column: 1 / -1; margin: 0; font-size: 12px; color: var(--n90-muted); }

  .n90-ar a:focus-visible,
  .n90-ar button:focus-visible { outline: 2px solid var(--n90-carbon); outline-offset: 3px; }

  @media screen and (max-width: 767px) {
    .n90-ar { padding: min({{ section.settings.padding_top }}px, 16px) 0 min({{ section.settings.padding_bottom }}px, 64px); }
    .n90-ar__media { margin-bottom: 36px; border-radius: 8px; }
    .n90-ar__body { font-size: 17px; }
    .n90-ar__nav { grid-template-columns: 1fr; }
    .n90-ar__nav .is-next { grid-column: auto; }
    .n90-ar__cform { grid-template-columns: 1fr; }
    .n90-ar__submit { justify-self: stretch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .n90-ar__head { animation: none; }
    .n90-ar__sh,
    .n90-ar__nav a,
    .n90-ar__submit { transition: none; }
  }
</style>

<article class="n90-ar" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="page-width">
    <div class="n90-ar__col">
      <a class="n90-ar__back" href="{{ blog.url }}">{%- render 'icon', name: 'arrow' -%}{{ blog.title | escape }}</a>

      <header class="n90-ar__head">
        {%- if article.tags.size > 0 -%}
          <ul class="n90-ar__tags" role="list">
            {%- for tag in article.tags limit: 3 -%}
              <li><a href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <h1 class="n90-ar__title" itemprop="headline">{{ article.title | escape }}</h1>
        <p class="n90-ar__meta">
          {%- if section.settings.show_author and article.author != blank -%}
            <span>{{ section.settings.by_label | escape }} <strong itemprop="author">{{ article.author | escape }}</strong></span>
          {%- endif -%}
          <span itemprop="datePublished">{{ article.published_at | time_tag: format: 'date' }}</span>
          <span>{{ read_mins }} {{ section.settings.read_time_label | escape }}</span>
        </p>
      </header>
    </div>

    {%- if article.image -%}
      <div class="n90-ar__wide">
        <div class="n90-ar__media">
          {%- assign hero_alt = article.image.alt | default: article.title -%}
          {{
            article.image
            | image_url: width: 2240
            | image_tag:
              widths: '600, 900, 1200, 1600, 2000, 2240',
              sizes: '(min-width: 1180px) 1120px, calc(100vw - 32px)',
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_alt
          }}
        </div>
      </div>
    {%- endif -%}

    <div class="n90-ar__col">
      <div class="n90-ar__body rte" itemprop="articleBody">{{ article.content }}</div>

      {%- if section.settings.show_share -%}
        <div class="n90-ar__share" data-ar-share>
          <p class="n90-ar__share-k">{{ section.settings.share_label | escape }}</p>
          <a class="n90-ar__sh" href="https://twitter.com/intent/tweet?url={{ share_url_enc }}&text={{ share_title_enc }}" target="_blank" rel="noopener" aria-label="{{ 'n90.a11y.share_on' | t: network: 'X' }}">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.8L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.9 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/></svg>
          </a>
          <a class="n90-ar__sh" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url_enc }}" target="_blank" rel="noopener" aria-label="{{ 'n90.a11y.share_on' | t: network: 'Facebook' }}">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z"/></svg>
          </a>
          <a class="n90-ar__sh" href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url_enc }}" target="_blank" rel="noopener" aria-label="{{ 'n90.a11y.share_on' | t: network: 'LinkedIn' }}">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3.3 9h3.4v11H3.3V9zm5.6 0h3.3v1.5h.1c.5-.9 1.6-1.8 3.3-1.8 3.5 0 4.1 2.3 4.1 5.3V20h-3.4v-5.3c0-1.3 0-2.9-1.8-2.9s-2.1 1.4-2.1 2.8V20H8.9V9z"/></svg>
          </a>
          <a class="n90-ar__sh" href="https://wa.me/?text={{ share_title_enc }}%20{{ share_url_enc }}" target="_blank" rel="noopener" aria-label="{{ 'n90.a11y.share_on' | t: network: 'WhatsApp' }}">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2z"/></svg>
          </a>
          <button type="button" class="n90-ar__sh" data-ar-copy="{{ share_url }}" aria-label="{{ 'general.share.copy_to_clipboard' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
          </button>
          <span class="n90-ar__copied" role="status" aria-live="polite" data-ar-copied></span>
        </div>
      {%- endif -%}

      {%- if blog.previous_article or blog.next_article -%}
        <nav class="n90-ar__nav" aria-label="{{ 'n90.a11y.more_stories' | t }}">
          {%- if blog.previous_article -%}
            <a href="{{ blog.previous_article.url }}" rel="prev">
              <span class="n90-ar__nav-k">← {{ section.settings.prev_label | escape }}</span>
              <span class="n90-ar__nav-v">{{ blog.previous_article.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if blog.next_article -%}
            <a class="is-next" href="{{ blog.next_article.url }}" rel="next">
              <span class="n90-ar__nav-k">{{ section.settings.next_label | escape }} →</span>
              <span class="n90-ar__nav-v">{{ blog.next_article.title | escape }}</span>
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
      <div class="n90-ar__journal"><a href="{{ blog.url }}">{{ section.settings.back_label | escape }}</a></div>

      {%- comment -%} ── Comments (when enabled on the blog) ── {%- endcomment -%}
      {%- if blog.comments_enabled? -%}
        <section class="n90-ar__comments" id="comments" aria-labelledby="n90-ar-comments-t">
          <h2 class="n90-ar__h2" id="n90-ar-comments-t">
            {%- if article.comments_count > 0 -%}{{ 'blogs.article.comments' | t: count: article.comments_count }}{%- else -%}{{ 'blogs.article.comment_form_title' | t }}{%- endif -%}
          </h2>
          {%- if article.comments_count > 0 -%}
            {%- paginate article.comments by 10 -%}
              {%- for comment in article.comments -%}
                <div class="n90-ar__comment" id="{{ comment.id }}">
                  {{ comment.content }}
                  <footer>{{ comment.author | escape }} · {{ comment.created_at | time_tag: format: 'date' }}</footer>
                </div>
              {%- endfor -%}
              {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate, anchor: '#comments' %}{%- endif -%}
            {%- endpaginate -%}
          {%- endif -%}

          {%- form 'new_comment', article, class: 'n90-ar__cform' -%}
            {%- if form.posted_successfully? -%}
              <p class="n90-ar__msg n90-ar__msg--ok" role="status">
                {%- if blog.moderated? -%}{{ 'blogs.article.success_moderated' | t }}{%- else -%}{{ 'blogs.article.success' | t }}{%- endif -%}
              </p>
            {%- elsif form.errors -%}
              <div class="n90-ar__msg n90-ar__msg--err" role="alert">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <div class="n90-ar__field">
              <label for="n90-ar-author">{{ 'blogs.article.name' | t }}</label>
              <input class="n90-ar__input" id="n90-ar-author" type="text" name="comment[author]" value="{{ form.author | escape }}" autocomplete="name" required>
            </div>
            <div class="n90-ar__field">
              <label for="n90-ar-email">{{ 'blogs.article.email' | t }}</label>
              <input class="n90-ar__input" id="n90-ar-email" type="email" name="comment[email]" value="{{ form.email | escape }}" autocomplete="email" autocapitalize="off" spellcheck="false" required>
            </div>
            <div class="n90-ar__field n90-ar__field--full">
              <label for="n90-ar-body">{{ 'blogs.article.message' | t }}</label>
              <textarea class="n90-ar__input" id="n90-ar-body" name="comment[body]" required>{{ form.body | escape }}</textarea>
            </div>
            {%- if blog.moderated? -%}
              <p class="n90-ar__note">{{ 'blogs.article.moderated' | t }}</p>
            {%- endif -%}
            <button type="submit" class="n90-ar__submit">{{ 'blogs.article.post' | t }}</button>
          {%- endform -%}
        </section>
      {%- endif -%}
    </div>
  </div>
</article>

<script>
  (function () {
    var btn = document.querySelector('[data-ar-copy]');
    var out = document.querySelector('[data-ar-copied]');
    if (!btn || !navigator.clipboard) return;
    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(btn.dataset.arCopy).then(function () {
        out.textContent = 'Link copied';
        setTimeout(function () { out.textContent = ''; }, 2500);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "class": "section-main-article",
  "enabled_on": { "templates": ["article"] },
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show share buttons", "default": true },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "by_label", "label": "Author prefix", "default": "By" },
    { "type": "text", "id": "read_time_label", "label": "Read time suffix", "default": "min read" },
    { "type": "text", "id": "share_label", "label": "Share label", "default": "Share" },
    { "type": "text", "id": "prev_label", "label": "Previous story label", "default": "Previous story" },
    { "type": "text", "id": "next_label", "label": "Next story label", "default": "Next story" },
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "Back to the journal" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 }
  ]
}
{% endschema %}
